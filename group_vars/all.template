---
# All Ansible variables are now generated by Terraform into inventory.yaml.
# Configure them in variables.auto.hcl (copied from variables.auto.hcl.template).

# Gen3 user access list — kept here (gitignored) to avoid committing user details.
# Each key is a user's email address; values follow the Fence usersync schema.
# See roles/gen3/templates/user.yaml.j2 for the full authz/policies context.
gen3_users:
  admin@example.com:
    tags:
      name: Admin User
      email: admin@example.com
    policies:
      - eLwaziProject_submitter